# Runtime profile: local-macos, sandbox-l40s, or bni-h200 (see config/profiles/<name>.env.example).
RUNTIME_PROFILE=local-macos
# Lab mode: local (mocks or local services) or cai (real services, no mocks).
LAB_MODE=local
GROUP_ID=group_01
DATA_MODE=csv
CSV_DATA_DIR=data/csv
VLLM_BASE_URL=http://bni-vllm-qwen35-9b.example.invalid/v1
VLLM_API_KEY=
# vLLM Application authentication: none (default) or bearer (adds --api-key from VLLM_API_KEY).
SERVICE_AUTH_MODE=none
MODEL_PATH=/mnt/models/Qwen3.5-9B
SERVED_MODEL_NAME=qwen3.5-9b
# GPU_PROFILE: l40s (sandbox) or h200 (BNI). Set it explicitly per environment.
GPU_PROFILE=h200
APP_STARTUP_TIMEOUT_MINUTES=15
CAI_PORT_MODE=app
QDRANT_URL=http://bni-qdrant.example.invalid
QDRANT_API_KEY=
QDRANT_COLLECTION=bni_training_knowledge
EMBEDDING_MODEL_PATH=/mnt/models/bge-m3
PHOENIX_ENDPOINT=http://bni-phoenix.example.invalid:6006/v1/traces
PHOENIX_API_KEY=
LITELLM_BASE_URL=http://bni-litellm.example.invalid/v1
IMPALA_HOST=
IMPALA_PORT=21050
IMPALA_DATABASE=bni_training
IMPALA_USERNAME=
IMPALA_PASSWORD=
IMPALA_KERBEROS_SERVICE_NAME=impala
IMPALA_CA_CERT=
CAI_API_BASE_URL=https://cai.example.invalid
CAI_API_KEY=replace-at-runtime
CAI_CA_BUNDLE=
# CDSW_APP_PORT is injected by Cloudera AI for each Application. Do not set it here.

