# Copy to .env (git-ignored) and fill in. Never commit the real file.
LITELLM_MASTER_KEY=<a long random key, for example: sk- followed by 64 hex characters>
POSTGRES_PASSWORD=<a long random password>
# Address of the shared vLLM Application, ending in /v1. Only needed if you want to send a test request from the UI.
VLLM_BASE_URL=<vllm address ending in /v1>
# Pin a released image tag when you have checked the LiteLLM releases page (default: main-stable).
# LITELLM_IMAGE=ghcr.io/berriai/litellm:<tag>
