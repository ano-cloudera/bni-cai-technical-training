PARTICIPANT_MODE=group_driver
PARTICIPANT_REF=participant_01
PARTICIPANT_WORKSPACE=workshop/runtime/groups/group_01
WORKSHOP_TOPOLOGY=single_project
DATA_BACKEND=csv
CSV_DATA_DIR=data/raw
