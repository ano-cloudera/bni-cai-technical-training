# Profile: local-macos (no NVIDIA GPU). Copy to an untracked .env. Labs run with --mode local.
RUNTIME_PROFILE=local-macos
LAB_MODE=local
GROUP_ID=group_01
DATA_MODE=csv
CSV_DATA_DIR=data/csv
