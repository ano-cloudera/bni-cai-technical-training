# Profile: sandbox-l40s. Copy to an untracked .env and fill every <placeholder> from the sandbox.
# Never commit the filled file. Hosts below use the reserved .invalid suffix on purpose.
RUNTIME_PROFILE=sandbox-l40s
LAB_MODE=cai
GROUP_ID=group_01
DATA_MODE=csv
CSV_DATA_DIR=data/csv
GPU_PROFILE=l40s
SERVICE_AUTH_MODE=bearer
SERVED_MODEL_NAME=qwen3.5-9b
MODEL_PATH=<nfs-path-to-Qwen3.5-9B>
EMBEDDING_MODEL_PATH=<nfs-path-to-bge-m3>
VLLM_BASE_URL=https://<vllm-application-domain>.invalid/v1
VLLM_API_KEY=<set-at-runtime>
QDRANT_URL=https://<qdrant-application-domain>.invalid
QDRANT_API_KEY=<set-at-runtime>
PHOENIX_COLLECTOR_ENDPOINT=https://<phoenix-application-domain>.invalid/v1/traces
PHOENIX_UI_URL=https://<phoenix-application-domain>.invalid
LITELLM_BASE_URL=https://<litellm-application-domain>.invalid/v1
WORKSHOP_PORTAL_URL=https://<portal-application-domain>.invalid
# Trainer only
LITELLM_MASTER_KEY=<set-at-runtime>
LITELLM_CONFIG=config/litellm.yaml
QDRANT_BINARY=<nfs-path-to-qdrant-binary>
QDRANT_STORAGE_PATH=<nfs-path-for-qdrant-storage>
PHOENIX_WORKING_DIR=<nfs-path-for-phoenix-data>
CAI_API_BASE_URL=https://<workbench-domain>.invalid
CAI_API_KEY=<set-at-runtime>
