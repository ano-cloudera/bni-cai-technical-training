MODEL_PATH=/mnt/models/Qwen3.5-9B
SERVED_MODEL_NAME=qwen3.5-9b
VLLM_API_KEY=replace-at-runtime
QDRANT_BINARY=/mnt/tools/qdrant/qdrant
QDRANT_STORAGE_PATH=/mnt/training/qdrant
PHOENIX_WORKING_DIR=/mnt/training/phoenix
LITELLM_CONFIG=config/litellm.yaml
# Required: the LiteLLM proxy refuses to start without a master key. Generate it at runtime, never commit it.
LITELLM_MASTER_KEY=
MOCK_FALLBACK_BASE_URL=http://127.0.0.1:8099/v1
# CDSW_APP_PORT is injected by Cloudera AI for each Application. Do not set it here.

